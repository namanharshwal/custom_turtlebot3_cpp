<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    NOTE: ros2_control hardware plugin is DISABLED.
    This robot uses arduino_bridge.py for direct motor control
    via GPIO UART (/dev/ttyAMA0 @ 115200).

    arduino_bridge.py publishes:
      /odom       → nav_msgs/Odometry
      /imu/data   → sensor_msgs/Imu
      TF: odom → base_link

    To re-enable ros2_control in future:
      plugin: diffdrive_arduino/DiffDriveArduino
      device: /dev/ttyAMA0
      baud_rate: 115200
      enc_counts_per_rev: 20   (LM393 encoder slots)
  -->
  <xacro:macro name="diffbot_ros2_control" params="name prefix">
    <!-- intentionally empty — using arduino_bridge.py instead -->
  </xacro:macro>
</robot>